# Existing application configuration
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
JWT_SECRET=
STUDYSYNC_ALLOWED_ORIGIN=http://localhost:5173

# AWS S3
AWS_REGION=ap-southeast-1
